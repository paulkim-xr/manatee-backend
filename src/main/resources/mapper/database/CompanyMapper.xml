<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.rathon.manatee.database.mapper.CompanyMapper">
<!--  CONFIG  -->
    <sql id="tableName">companies</sql>
    <sql id="sorting">
        ORDER BY
        <choose>
            <when test="sortColumn == 'id'">c.id</when>
            <when test="sortColumn == 'name'">c.name</when>
            <when test="sortColumn == 'address'">c.address</when>
            <when test="sortColumn == 'industry'">i.name</when>
            <when test="sortColumn == 'registrationNumber'">c.registration_number</when>
            <when test="sortColumn == 'unitCount'">unit_count</when>
            <when test="sortColumn == 'employeeCount'">employee_count</when>
        </choose>
        <choose>
            <when test="sortDirection == 'desc'">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
    </sql>
    <sql id="paging">
        <if test="size != null and offset != null">
            LIMIT #{size}
            OFFSET #{offset}
        </if>
    </sql>

<!--  ObjectMapper  -->

    <select id="findById" resultType="java.lang.Object">
        SELECT *
        FROM <include refid="tableName" />
        WHERE id = #{id}
    </select>

    <select id="findAll" resultType="java.lang.Object">
        SELECT *
        FROM <include refid="tableName" />
    </select>

    <select id="getPagedObjects" resultType="java.lang.Object">
        SELECT *
        FROM <include refid="tableName" />
        <include refid="sorting" />
        <include refid="paging" />
    </select>

    <select id="getCount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM <include refid="tableName" />
    </select>


    <select id="searchTemplate" resultType="java.lang.Object">
        SELECT NULL
        FROM <include refid="tableName" />
        <where>
            FALSE
            <if test="name != null">
                OR c.name ILIKE CONCAT('%', #{name}, '%')
            </if>
            <!-- TABLE COLUMNS -->
        </where>
        <include refid="sorting" />
        <include refid="paging" />
    </select>

    <select id="searchCountTemplate" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM <include refid="tableName" />
        <where>
            FALSE
            <if test="name != null">
                OR c.name ILIKE CONCAT('%', #{name}, '%')
            </if>
            <!-- TABLE COLUMNS -->
        </where>
        <include refid="sorting" />
        <include refid="paging" />
    </select>


    <insert id="insert" parameterType="Company" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO <include refid="tableName" />
        (name, address, industry_id, registration_number)
        VALUES (#{name}, #{address}, #{industryId}, #{registrationNumber})
    </insert>

    <update id="update" parameterType="Company">
        UPDATE <include refid="tableName" /> SET
        name = #{name}, address = #{address}, industry_id = #{industryId}, registration_number = #{registrationNumber}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM <include refid="tableName" />
        WHERE id = #{id}
    </delete>

    <!-- DIRECT DTO QUERIES -->

    <select id="findByIdDto" resultMap="ObjectResultMap.CompanyDtoMap">
        <include refid="ObjectResultMap.CompanyDtoSql" />
        WHERE c.id = #{id}
    </select>

    <select id="findAllDto" resultMap="ObjectResultMap.CompanyDtoMap">
        <include refid="ObjectResultMap.CompanyDtoSql" />
        ORDER BY c.id
        <include refid="paging" />
    </select>

    <select id="getPagedObjectsDto" resultMap="ObjectResultMap.CompanyDtoMap">
        <include refid="ObjectResultMap.CompanyDtoSql" />
        <include refid="sorting" />
        <include refid="paging" />
    </select>

<!--    -->
<!--  CompanyMapper  -->

    <select id="getRootUnitDto" resultMap="ObjectResultMap.UnitDtoMap">
        <include refid="ObjectResultMap.UnitDtoSql" />
        WHERE u.company_id = #{id} AND u.type_id = 1
        ORDER BY u.id
    </select>

    <select id="getUnitsDto" resultMap="ObjectResultMap.UnitDtoMap">
        <include refid="ObjectResultMap.UnitDtoSql" />
        WHERE u.company_id = #{id}
        <if test="!root">
            AND NOT u.type_id = 1
        </if>
        ORDER BY u.id
    </select>

    <select id="getEmployeesDto" resultMap="ObjectResultMap.EmployeeDtoMap">
        <include refid="ObjectResultMap.EmployeeDtoSql" />
        WHERE u.company_id = #{id}
        ORDER BY e.id
    </select>

    <select id="search" resultMap="ObjectResultMap.CompanyDtoMap">
        <include refid="ObjectResultMap.CompanyDtoSql" />
        <where>
            FALSE
            <if test="name != null">
                OR c.name ILIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="address != null">
                OR c.address ILIKE CONCAT('%', #{address}, '%')
            </if>
            <if test="industry != null">
                OR i.name ILIKE CONCAT('%', #{industry}, '%')
            </if>
            <if test="registrationNumber != null">
                OR c.registration_number ILIKE CONCAT('%', #{registrationNumber}, '%')
            </if>
        </where>
        <include refid="sorting" />
        <include refid="paging" />
    </select>

</mapper>