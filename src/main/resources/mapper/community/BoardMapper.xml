<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.rathon.manatee.community.mapper.BoardMapper">
    <select id="findById" resultType="Board">
        SELECT * FROM boards WHERE id = #{id}
    </select>

    <select id="findAll" resultType="Board">
        SELECT * FROM boards
    </select>

    <select id="getPostList" resultType="Post">
        SELECT * FROM posts WHERE board_id = #{id}
    </select>

    <insert id="insert" parameterType="Board" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO boards
        (group_id, name, description, type)
        VALUES (#{groupId}, #{name}, #{description}, #{type})
    </insert>

    <update id="update" parameterType="Board">
        UPDATE boards SET
        group_id = #{groupId}, name = #{name}, description = #{description}, type = #{type}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM boards WHERE id = #{id}
    </delete>

    <insert id="insert" parameterType="java.lang.Object" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO <include refid="table" />
        (group_id, name, description, type)
        VALUES (#{groupId}, #{name}, #{description}, #{type})
    </insert>

    <update id="update" parameterType="java.lang.Object">
        UPDATE <include refid="table" /> SET
        group_id = #{groupId}, name = #{name}, description = #{description}, type = #{type}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM <include refid="table" /> WHERE id = #{id}
    </delete>
</mapper>