<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.rathon.manatee.community.mapper.BoardGroupMapper">
    <select id="findById" resultType="BoardGroup">
        SELECT * FROM board_groups WHERE id = #{id}
    </select>

    <select id="getChildGroups" resultType="BoardGroup">
        SELECT * FROM board_groups WHERE parent_id = #{id}
    </select>

    <select id="getBoards" resultType="Board">
        SELECT * FROM boards WHERE group_id = #{id}
    </select>
</mapper>