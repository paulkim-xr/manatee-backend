<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ObjectResultMap">

    <sql id="CompanyDtoJOIN">
        FROM companies
        LEFT JOIN industries ON industries.id = companies.industry_id
        LEFT JOIN (
            SELECT units.company_id, COUNT(*) AS unit_count
            FROM units
            WHERE NOT units.type_id = 1
            GROUP BY units.company_id
        ) uc ON uc.company_id = companies.id
        LEFT JOIN (
            SELECT units.company_id, COUNT(employees.id) AS employee_count
            FROM units
            LEFT JOIN employees ON employees.unit_id = units.id
            GROUP BY units.company_id
        ) ec ON ec.company_id = companies.id
    </sql>
    <sql id="CompanyDtoSelect">
        SELECT
            companies.id,
            companies.name,
            companies.address,
            industries.id AS industry_id,
            industries.name AS industry_name,
            companies.registration_number,
            COALESCE(uc.unit_count, 0) AS unit_count,
            COALESCE(ec.employee_count, 0) AS employee_count
        <include refid="ObjectResultMap.CompanyDtoJOIN" />
    </sql>

    <sql id="EmployeeDtoJOIN">
        FROM employees
        LEFT JOIN units ON units.id = employees.unit_id
        LEFT JOIN positions ON positions.id = employees.position_id
        LEFT JOIN companies ON companies.id = units.company_id
    </sql>
    <sql id="EmployeeDtoSelect">
        SELECT
            employees.id,
            companies.id AS company_id,
            companies.name AS company_name,
            units.id AS unit_id,
            units.name AS unit_name,
            positions.id AS position_id,
            positions.name AS position_name,
            employees.name,
            employees.username,
            employees.email,
            employees.phone,
            employees.dob
        <include refid="ObjectResultMap.EmployeeDtoJOIN" />
    </sql>

    <sql id="UnitDtoJOIN">
        FROM units
        LEFT JOIN companies ON units.company_id = companies.id
        LEFT JOIN unit_types ON units.type_id = unit_types.id
        LEFT JOIN units parent ON units.parent_id = parent.id
        LEFT JOIN (
            SELECT employees.unit_id, COUNT(*) AS employee_count
            FROM employees
            GROUP BY employees.unit_id
        ) ec ON ec.unit_id = units.id
    </sql>
    <sql id="UnitDtoSelect">
        SELECT
            units.id,
            companies.id AS company_id,
            companies.name AS company_name,
            units.name,
            unit_types.id AS type_id,
            unit_types.name AS type_name,
            units.code,
            parent.id AS parent_id,
            parent.name AS parent_name,
            COALESCE(ec.employee_count, 0) AS employee_count
        <include refid="ObjectResultMap.UnitDtoJOIN" />
    </sql>

    <resultMap id="IndustryResultMap" type="Industry">
        <constructor>
            <idArg name="id" column="industry_id" javaType="java.lang.Long"/>
            <arg name="name" column="industry_name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="PositionResultMap" type="Position">
        <constructor>
            <idArg name="id" column="position_id" javaType="java.lang.Long"/>
            <arg name="name" column="position_name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="UnitTypeResultMap" type="UnitType">
        <constructor>
            <idArg name="id" column="type_id" javaType="java.lang.Long"/>
            <arg name="name" column="type_name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="CompanyDtoMap" type="CompanyDto">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
        <result property="registrationNumber" column="registration_number"/>
        <result property="unitCount" column="unit_count"/>
        <result property="employeeCount" column="employee_count"/>
        <association property="industry" resultMap="IndustryResultMap"/>
    </resultMap>

    <resultMap id="EmployeeDtoMap" type="EmployeeDto">
        <id property="id" column="id"/>

        <result property="name" column="name"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="dob" column="dob" javaType="java.util.Date"/>

        <association property="company" javaType="IdNameDto">
            <constructor>
                <idArg name="id" column="company_id" javaType="java.lang.Long"/>
                <arg name="name" column="company_name" javaType="java.lang.String"/>
            </constructor>
        </association>

        <association property="unit" javaType="IdNameDto">
            <constructor>
                <idArg name="id" column="unit_id" javaType="java.lang.Long"/>
                <arg name="name" column="unit_name" javaType="java.lang.String"/>
            </constructor>
        </association>

        <association property="position" resultMap="PositionResultMap"/>
    </resultMap>

    <resultMap id="UnitDtoMap" type="UnitDto">
        <id property="id" column="id"/>

        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="childrenCount" column="children_count"/>
        <result property="employeeCount" column="employee_count"/>

        <association property="company" javaType="IdNameDto">
            <constructor>
                <idArg name="id" column="company_id" javaType="java.lang.Long"/>
                <arg name="name" column="company_name" javaType="java.lang.String"/>
            </constructor>
        </association>

        <association property="type" resultMap="UnitTypeResultMap"/>

        <association property="parent" javaType="IdNameDto">
            <constructor>
                <idArg name="id" column="parent_id" javaType="java.lang.Long"/>
                <arg name="name" column="parent_name" javaType="java.lang.String"/>
            </constructor>
        </association>
    </resultMap>
</mapper>