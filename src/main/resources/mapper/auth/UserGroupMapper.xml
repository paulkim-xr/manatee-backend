    <select id="findByUserId" resultType="UserGroup">
        SELECT * FROM user_groups
        WHERE id IN (
            SELECT group_id FROM user_group_mapping
            WHERE user_id = #{id}
        )
    </select>

    <select id="findByRoleId" resultType="UserGroup">
        SELECT * FROM user_groups
        WHERE id IN (
        SELECT group_id FROM role_mapping
        WHERE role_id = #{id}
        )
    </select>

    <insert id="mapEmployees">
        INSERT INTO user_group_mapping (group_id, user_id)
        SELECT #{id}, unnest(ARRAY
        <foreach collection="ids" item="item" separator=",">
            #{item}
        </foreach>
        )::bigint[]
        ON CONFLICT (role_id, group_id) DO NOTHING
    </insert>

    <insert id="mapRoles">
        INSERT INTO role_mapping (group_id, role_id)
        SELECT #{id}, unnest(ARRAY
        <foreach collection="ids" item="item" separator=",">
            #{item}
        </foreach>
        )::bigint[]
        ON CONFLICT (role_id, group_id) DO NOTHING
    </insert>

