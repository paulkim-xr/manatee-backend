<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.rathon.manatee.auth.mapper.UserPermissionMapper">
    <!-- CONFIG -->
    <sql id="tableName">
        permissions
    </sql>
    <sql id="searchCols">
        <where>
            FALSE
            <!-- TABLE COLUMNS -->
<!--            <if test="name != null">-->
<!--                OR <include refid="tableName" />.name ILIKE CONCAT('%', #{name}, '%')-->
<!--            </if>-->
        </where>
    </sql>
    <sql id="searchColsDto">
        <where>
            FALSE
            <!-- TABLE COLUMNS -->
<!--            <if test="name != null">-->
<!--                OR <include refid="tableName" />.name ILIKE CONCAT('%', #{name}, '%')-->
<!--            </if>-->
        </where>
    </sql>
    <sql id="sorting">
        ORDER BY
        <choose>
            <when test="sortColumn == 'id'">id</when>
            <!-- TABLE COLUMNS -->
        </choose>
        <choose>
            <when test="sortDirection == 'desc'">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
    </sql>
    <sql id="paging">
        <if test="size != null and offset != null">
            LIMIT #{size}
            OFFSET #{offset}
        </if>
    </sql>

<!--  ObjectMapper  -->

    <select id="findById" resultType="UserPermission">
        SELECT *
        FROM <include refid="tableName" />
        WHERE id = #{id}
    </select>

    <select id="findAll" resultType="UserPermission">
        SELECT *
        FROM <include refid="tableName" />
    </select>

    <select id="getPagedObjects" resultType="UserPermission">
        SELECT *
        FROM <include refid="tableName" />
        <include refid="sorting" />
        <include refid="paging" />
    </select>

    <select id="getCount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM <include refid="tableName" />
    </select>


    <select id="search" resultType="UserPermission">
        SELECT *
        FROM <include refid="tableName" />
        <include refid="searchCols" />
        <include refid="sorting" />
        <include refid="paging" />
    </select>
    
    <select id="searchCount" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM <include refid="tableName" />
        <include refid="searchCols" />
    </select>


    <insert id="insert" parameterType="UserPermission" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO <include refid="tableName" /> (
        name, parent_id
        ) VALUES (
        #{name}, #{parent_id}
        )
    </insert>

    <update id="update" parameterType="UserPermission">
        UPDATE <include refid="tableName" /> SET
        name = #{name}, parent_id = #{parentId}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="long">
        DELETE FROM <include refid="tableName" />
        WHERE id = #{id}
    </delete>

